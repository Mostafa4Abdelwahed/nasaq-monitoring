# ════════════════════════════════════════════════════════════════
#  nasaq-monitoring — المتغيرات البيئية
#  انسخ هذا الملف إلى .env ثم عدّل القيم:  cp .env.example .env
#  ⚠️  ملف .env مرفوض في git — لا ترفعه أبداً.
# ════════════════════════════════════════════════════════════════

# ─── عام ───
# المنطقة الزمنية (كل الـ timestamps والتنبيهات هتظهر بيها)
TZ=Africa/Cairo

# مجلد تخزين داتا الـ Docker volumes على الهوست (persistent)
DATA_DIR=./data

# ─── Grafana ───
# كلمة مرور admin (ولّدها بقوة: install.sh بيعمل ده تلقائياً)
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# المستخدم اللي يدخل بيها أول مرة
GF_SECURITY_ADMIN_USER=admin

# ─── Prometheus ───
# كم يوم تحتفظ بمقاييس Prometheus (7 = كويس لسيرفر صغير)
PROMETHEUS_RETENTION=15d

# ─── Loki ───
# كم يوم تحتفظ باللوجات
LOKI_RETENTION=14d

# ─── Alertmanager → Telegram ───
# إنشاء البوت: تحدّث مع @BotFather على تيليجرام ← /newbot ثم خد التوكن
# لمعرفة chat_id: ابعاد أي رسالة للبوت ثم افتح telegram.org/api#bot-api
# أو استخدم @userinfobot لتشوف الـ chat id بتاعك.
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789

# ─── targets-manager (إدارة الخدمات) ───
# توكن لحماية الـ API — install.sh بولّده عشوائي 48 حرف
TARGETS_MANAGER_TOKEN=CHANGE_ME_RANDOM_TOKEN

# ─── Ports (على الهوست) ───
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
TARGETS_MANAGER_PORT=8081
